# ==================================
# Telegram Chat Summarizer - Config
# ==================================

# 1. Get API_ID and API_HASH from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# 2. Create a bot via @BotFather on Telegram and paste the token
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# 3. Get your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Your Telegram user ID (send /start to @userinfobot to get it)
OWNER_ID=123456789

# 5. (Optional) Gemini model — default is gemini-2.0-flash (free)
# GEMINI_MODEL=gemini-2.0-flash
